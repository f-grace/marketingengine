# Copy to .env. Never commit .env.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Optional. Path to a Google service-account JSON for the Sheets export.
# Leave blank to use CSV export only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional but recommended. Free key, no card, instant:
# https://www.pexels.com/api/
# Without it slides render on gradient grounds instead of photos.
PEXELS_API_KEY=

# Optional. Path to a heavy .ttf if you want a specific face.
SLIDE_FONT=
