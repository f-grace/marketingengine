# Copy to .env. Never commit .env.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Gmail delivery for the recreation-prompt digest. All three are required for
# `python -m engine email`; leave blank to keep prompts on disk only.
#
# GMAIL_APP_PASSWORD is a Google App Password, not your account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# (App passwords require 2-Step Verification to be enabled.)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where the digest goes. May equal GMAIL_ADDRESS.
DIGEST_TO=
